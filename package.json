{
  "name": "skillmap-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd skillmap-ai && npm run dev",
    "dev:backend": "cd skillmap-backend && python -m uvicorn main:app --reload",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:all": "npm install --prefix skillmap-ai && pip install -r skillmap-backend/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
